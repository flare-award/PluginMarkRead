{
    "name": "markread-relay",
    "version": "1.0.0",
    "private": true,
    "description": "Self-hosted relay for MarkRead, a cooperative read-receipt plugin for Vencord",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=20"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "dev": "node --watch dist/index.js",
        "test": "npm run build && node --test \"test/*.test.mjs\"",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/ws": "^8.5.13",
        "typescript": "^5.7.0"
    }
}
